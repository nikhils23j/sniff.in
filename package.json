  "name": "sniff-in",
  "version": "3.3.1",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/ui": "~58.0.23",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.9.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.4",
    "date-fns": "^4.4.0",
    "expo": "~58.0.19",
    "expo-auth-session": "~58.0.14",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "tus-js-client": "^4.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "pg": "^8.23.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:db": "scripts/db-local-reset.sh && node --test --test-concurrency=1 'supabase/tests/db/*.test.mjs'",
    "db:reset:local": "scripts/db-local-reset.sh",
    "test:db:load": "node supabase/tests/load/db-load.mjs",
    "functions:check": "cd supabase/functions && deno check */index.ts",
    "test:e2e:live": "node --env-file=.env.staging scripts/e2e-live.mjs",
    "test:auth:staging": "node --env-file=.env.staging scripts/staging-auth-burst.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@supabase/.*|zod)"
    ]
  }
}
