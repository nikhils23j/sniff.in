# ---------------------------------------------------------------------------
# Sniff.in environment. Copy to `.env` (git-ignored) and fill in.
# Only EXPO_PUBLIC_* values are bundled into the app. They must be PUBLISHABLE.
# NEVER put the service-role key, DB password, or any AI key in an EXPO_PUBLIC_ var.
# ---------------------------------------------------------------------------

# --- App (bundled, public) --------------------------------------------------
EXPO_PUBLIC_APP_ENV=development            # development | staging | production
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
EXPO_PUBLIC_APP_URL=https://sniff.in       # base for QR/invite links: <APP_URL>/join?t=<token>
EXPO_PUBLIC_PRIVACY_URL=https://sniff.in/privacy
EXPO_PUBLIC_TERMS_URL=https://sniff.in/terms
EXPO_PUBLIC_SUPPORT_EMAIL=support@sniff.in
APP_LINK_DOMAIN=                        # HTTPS host in EXPO_PUBLIC_APP_URL, without scheme
EXPO_PUBLIC_TURNSTILE_SITE_KEY=         # public key; leave empty until hosted widget + Auth secret are configured
EXPO_PUBLIC_CAPTCHA_URL=https://sniff.in/captcha/
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=          # public Client ID; Android connection stays disabled when empty

# --- Local scripts only (seed / API load test). NEVER bundled. ---------------
# Used by scripts/seed-dev.mjs and scripts/load-test-api.mjs against a DEV/STAGING project.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# --- Edge Function secrets: set with `supabase secrets set KEY=value`, NOT here in production ---
# AI_PROVIDER=openai                 # or: anthropic
# OPENAI_API_KEY=
# AI_MODEL=gpt-5.4-mini              # anthropic default: claude-opus-5-5
# EMBEDDINGS_PROVIDER=openai         # or: voyage
# EMBEDDINGS_MODEL=text-embedding-3-small   # 1024 dims requested; voyage default: voyage-3.5
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=
# PUSH_WEBHOOK_SECRET=
# EXPO_ACCESS_TOKEN=
